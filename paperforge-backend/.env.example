PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Firebase web config (Firebase console > Project settings > Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Long random string used to sign login tokens
JWT_SECRET=change-me
# Initial account, created in Firestore (collection "paperforge_users") on first start
SEED_USERNAME=forge
SEED_PASSWORD=Forge@2026
SEED_DISPLAY_NAME=PaperForge Trader

# Leave empty for the (default) database, or set the Database ID shown in the Firestore console
FIRESTORE_DATABASE_ID=

# Gemini completed-trade reviews (server-only; never expose in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
