{
  "name": "paperforge-futures",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/liquidation.test.mjs tests/account.test.mjs tests/competition.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts next.config.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "PaperForge Futures"
}
